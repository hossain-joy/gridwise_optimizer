# Server config
PORT=8000

# LLM Configuration (Google AI Studio / Gemini - Recommended & Free)
# Get your free API key at: https://aistudio.google.com/
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_google_ai_studio_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Alternative: OpenAI Configuration
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_openai_api_key_here

# Note: If LLM_API_KEY is omitted or offline, GridWise automatically 
# uses its deterministic rule-based NLP extractor (0ms latency, zero downtime).
